# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Numeric Telegram ids of the admins (get yours from @userinfobot), comma separated
ADMIN_IDS=
# Extra allowed users besides the admins (admins can also add users with /adduser). Empty = admins only
ALLOWED_USER_IDS=
# Folder with your CSV and DB files (relative to the project folder, or a full path)
DATA_DIR=data
# Search index file (created automatically)
DB_PATH=index.db
# Telegram Bot API server (empty = https://api.telegram.org)
# Set it to use a mirror or reverse proxy, e.g. https://my-mirror.example.com
TELEGRAM_API_URL=
# Seconds between folder scans
SCAN_INTERVAL=60
PAGE_SIZE=5
# Limits for regular users (0 = unlimited): searches per hour, searches per day, results viewable per search
SEARCH_LIMIT_HOUR=60
SEARCH_LIMIT_DAY=300
MAX_RESULTS=50
# Days to keep the search log (0 = forever)
AUDIT_DAYS=180
# If Telegram is blocked: SOCKS port of your VPN app (v2rayN usually 10808, V2RayU usually 1080)
# Leave empty if the VPN covers the whole system (TUN mode). `python -m csvbot.check` can find it automatically.
PROXY=
