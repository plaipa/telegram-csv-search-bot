# از https://my.telegram.org → API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-DEF...
# شناسه عددی کانال (مثلاً -1001234567890) یا @username
CHANNEL=
# شناسه عددی ادمین‌ها (از @userinfobot)، با کاما جدا کنید
ADMIN_IDS=
# کاربرانی که اجازه جستجو دارند — خالی = همه
ALLOWED_USER_IDS=
DB_PATH=data.db
# محل ذخیره موقت فایل هنگام دانلود (بعد از ثبت پاک می‌شود)
DOWNLOAD_DIR=downloads
PAGE_SIZE=5
