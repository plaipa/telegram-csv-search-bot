# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-DEF...
# شناسه عددی ادمین‌ها (از @userinfobot)، با کاما جدا کنید
ADMIN_IDS=
# کاربران مجاز علاوه بر ادمین‌ها (ادمین هم با /adduser می‌تواند اضافه کند). خالی = فقط ادمین‌ها
ALLOWED_USER_IDS=
# پوشه‌ای که فایل‌های CSV و DB را در آن می‌گذارید (نسبت به پوشه‌ی پروژه یا مسیر کامل)
DATA_DIR=data
# فایل دیتابیس جستجو (خودکار ساخته می‌شود)
DB_PATH=index.db
# آدرس سرور Bot API تلگرام (خالی = https://api.telegram.org)
# برای استفاده از آدرس جایگزین/واسط، مثلاً https://my-mirror.example.com
TELEGRAM_API_URL=
# هر چند ثانیه پوشه بررسی شود
SCAN_INTERVAL=60
PAGE_SIZE=5
# سقف برای کاربران عادی (0 = بدون سقف): جستجو در ساعت، جستجو در روز، نتایج قابل مشاهده در هر جستجو
SEARCH_LIMIT_HOUR=60
SEARCH_LIMIT_DAY=300
MAX_RESULTS=50
# گزارش جستجوها چند روز نگه داشته شود (0 = همیشه)
AUDIT_DAYS=180
# اگر تلگرام فیلتر است: پورت SOCKS برنامه VPN (v2rayN معمولاً 10808، V2RayU معمولاً 1080)
# اگر VPN کل سیستم را پوشش می‌دهد (TUN mode) خالی بگذارید. python -m csvbot.check خودکار پیدا می‌کند.
PROXY=
