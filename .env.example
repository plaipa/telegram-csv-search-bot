# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-DEF...
# شناسه عددی کانال (مثلاً -1001234567890) یا @username — خالی = همه کانال‌هایی که ربات در آن ادمین است
CHANNEL_ID=
# شناسه عددی ادمین‌ها (از @userinfobot بگیرید)، با کاما جدا کنید
ADMIN_IDS=
# کاربرانی که اجازه جستجو دارند — خالی = همه
ALLOWED_USER_IDS=
DB_PATH=data.db
PAGE_SIZE=5
